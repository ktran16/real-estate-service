# Copy to .env and fill in as needed. All values have sensible defaults (see
# src/danang_realestate/config.py); everything here is optional for Phase 1.

# --- Geocoding (optional in Phase 1; Nominatim is used by default) ---
GOONG_API_KEY=

# --- Database ---
DUCKDB_PATH=./data/danang.duckdb

# --- Scraping politeness ---
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=8
# Optional extra user agent added to the rotation pool.
SCRAPE_USER_AGENT=

# --- Nominatim (OpenStreetMap) ---
NOMINATIM_USER_AGENT=danang-realestate/0.1.0 (personal-project)
