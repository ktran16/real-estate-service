# Copy to .env and fill in as needed. Most values have sensible defaults (see
# src/danang_realestate/config.py). EXCEPTION: the Postgres serving DB needs a real
# POSTGRES_PASSWORD (no default anywhere) — required once you run the Postgres/Metabase
# and orchestration stacks.

# --- Geocoding (optional in Phase 1; Nominatim is used by default) ---
GOONG_API_KEY=

# --- Database ---
DUCKDB_PATH=./data/danang.duckdb

# --- Scraping politeness ---
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=8
# Optional extra user agent added to the rotation pool.
SCRAPE_USER_AGENT=

# --- Nominatim (OpenStreetMap) ---
NOMINATIM_USER_AGENT=danang-realestate/0.1.0 (personal-project)

# --- Postgres serving DB (what Metabase reads; pipeline publishes marts here) ---
# REQUIRED secret — no default anywhere. Use a strong value and keep it out of git.
# Used both by the Postgres container (POSTGRES_PASSWORD) and the pipeline (PG_PASSWORD,
# which also accepts POSTGRES_PASSWORD). Copy this file to .env in the repo root AND into
# metabase/ and orchestration/ (docker compose loads .env from each compose dir).
POSTGRES_PASSWORD=change-me-to-a-strong-password
PG_HOST=localhost
PG_PORT=5433
PG_DB=danang
PG_USER=danang
PG_SCHEMA=public

# --- Alerting (optional) ---
# Slack incoming-webhook URL. If set, a Dagster failure sensor posts here when the
# daily refresh or the weekly schema-drift check fails. Leave empty to disable.
SLACK_WEBHOOK_URL=

# Email alerting (optional second channel for failures). Disabled unless SMTP_HOST,
# ALERT_EMAIL_FROM and ALERT_EMAIL_TO are all set. ALERT_EMAIL_TO is comma-separated.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Metabase dashboards-as-code (metabase/provision.py; optional) ---
# Used only when (re)provisioning or exporting dashboards from the YAML specs.
MB_URL=http://localhost:3001
# Authenticate with EITHER an API key OR an admin username + password.
MB_API_KEY=
MB_USERNAME=
MB_PASSWORD=
# Host/port Metabase uses to reach Postgres when --create-database creates the connection.
# Defaults to the compose service name (Metabase connects over the danang-net network).
MB_PG_HOST=postgres
MB_PG_PORT=5432
