# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual env
.venv/
venv/

# Environment / secrets
.env

# DuckDB data (regenerable)
data/*.duckdb
data/*.duckdb.wal

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Metabase (driver jar + app state are downloaded/generated, not source)
metabase/plugins/
metabase/metabase-data/

# Session handoff notes (local working state, not source)
HANDOFF.md

# Scheduled-refresh runtime artifacts
logs/
.refresh.lock

# Dagster runtime state (keep dagster.yaml, ignore the SQLite storage/run history)
.dagster_home/*
!.dagster_home/dagster.yaml
.tmp_dagster_home*/

# Claude Code local runtime state
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude
